# ---------------------------------------------------------------------------
# Copy to backend/.env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# Database -------------------------------------------------------------------
# SQLite (default for local development):
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (switch to this when Postgres is available -- no code changes):
# DATABASE_URL=postgres://joa:joa@127.0.0.1:5432/job_outreach

# API ------------------------------------------------------------------------
API_PAGE_SIZE=20
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT ------------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Auth rate limiting ---------------------------------------------------------
# Applies only to the endpoints that declare a throttle scope.
THROTTLE_AUTH_LOGIN=10/min
THROTTLE_AUTH_REGISTER=20/hour
THROTTLE_AUTH_PASSWORD=10/hour

# Crawler --------------------------------------------------------------------
# Conservative by default: identifies itself, obeys robots.txt, waits between
# requests, and stops early rather than spidering a whole site.
CRAWLER_REQUEST_TIMEOUT=10
CRAWLER_MAX_PAGES=40
CRAWLER_MAX_DEPTH=2
CRAWLER_DELAY_SECONDS=0.5
CRAWLER_RESPECT_ROBOTS_TXT=True
CRAWLER_MAX_RESPONSE_BYTES=2000000
CRAWLER_MAX_REDIRECTS=5
# DANGER: this disables SSRF protection. Leave False anywhere real users can
# reach the API. Only useful for crawling a local fixture site.
CRAWLER_ALLOW_PRIVATE_NETWORKS=False

# Celery / Redis -------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# True  -> scans run inline in the web process (no Redis or worker needed).
# False -> scans are queued; you must run Redis and a Celery worker.
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=True
