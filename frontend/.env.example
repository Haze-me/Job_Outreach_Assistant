# Copy to frontend/.env.local and adjust. Only VITE_-prefixed variables are
# exposed to the browser bundle -- never put a secret in this file.

# Where the API lives. The default "/api" relies on the Vite dev proxy (see
# vite.config.js). Set an absolute URL when the frontend is served from a
# different origin than the backend.
VITE_API_BASE_URL=/api

# Dev-server proxy target. Change if Django runs somewhere other than :8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
